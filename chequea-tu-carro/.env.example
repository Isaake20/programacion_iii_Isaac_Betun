# Copia este archivo a .env y completa tus valores.
# Sin VERIFIK_TOKEN, la app arranca en MODO DEMO (datos de ejemplo), ideal para desarrollo.

# Puerto del servidor
PORT=3000

# Token (JWT Bearer) de tu cuenta del proveedor de datos licenciado.
# Mientras esté vacío, la app usa datos de ejemplo y lo indica en pantalla.
VERIFIK_TOKEN=

# Base del proveedor (por defecto Verifik). Cambia solo si usas otro.
VERIFIK_BASE=https://api.verifik.co

# Cuántos segundos cachear cada placa para no gastar consultas de más (y dinero).
CACHE_TTL_SECONDS=600

# Límite simple de consultas por IP por minuto.
RATE_LIMIT_PER_MIN=20
